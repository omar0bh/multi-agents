# LLM & Multi-Agent Keys
OPENCODE_ZEN_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=groq/openai/gpt-oss-120b

# Telegram Employee Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Email (Gmail SMTP for sending files/reports)
SMTP_EMAIL=
SMTP_PASSWORD=

# Cloud-to-Local Bridge
# Set a long random secret (e.g. openssl rand -hex 32) on BOTH AWS and local PC .env
AWS_SERVER_URL=http://127.0.0.1:8000
BRIDGE_SECRET=

# Discord Architect Bot
DISCORD_BOT_TOKEN=
